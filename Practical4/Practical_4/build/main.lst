12704:Core/Src/main.c **** void EXTI0_IRQHandler(void){
12705:Core/Src/main.c **** 
12706:Core/Src/main.c ****     /* Debounce using HAL_GetTick() */
12707:Core/Src/main.c ****     static uint32_t last_tick = 0;
12708:Core/Src/main.c ****     uint32_t now = HAL_GetTick();
12709:Core/Src/main.c ****     if ((now - last_tick) < DEBOUNCE_DELAY_MS) // ignore if <200ms since last press
12710:Core/Src/main.c ****     {
12711:Core/Src/main.c ****         HAL_GPIO_EXTI_IRQHandler(Button0_Pin); // clear interrupt flags
12712:Core/Src/main.c ****         return;
12713:Core/Src/main.c ****     }
12714:Core/Src/main.c ****     last_tick = now;
12715:Core/Src/main.c **** 
12716:Core/Src/main.c ****     /* Stop DMA requests and abort transfer safely */
12717:Core/Src/main.c ****     __HAL_TIM_DISABLE_DMA(&htim2, TIM_DMA_CC1);
12718:Core/Src/main.c ****     (void)HAL_DMA_Abort_IT(&hdma_tim2_ch1);
12719:Core/Src/main.c **** 
12720:Core/Src/main.c ****     /* Wait until DMA is actually ready (abort completed) */
12721:Core/Src/main.c ****     while (hdma_tim2_ch1.State != HAL_DMA_STATE_READY) {
12722:Core/Src/main.c ****         /* small spin; should be quick */
12723:Core/Src/main.c ****     }
12724:Core/Src/main.c **** 
12725:Core/Src/main.c ****     /* cycle through waveforms */
ARM GAS  C:\Users\danie\AppData\Local\Temp\ccGXTFBc.s 			page 229


12726:Core/Src/main.c ****     static int wave_idx = 0;
12727:Core/Src/main.c ****     wave_idx = (wave_idx + 1) % NUM_WAVES;
12728:Core/Src/main.c **** 
12729:Core/Src/main.c ****     /* restart DMA with new LUT */
12730:Core/Src/main.c ****     if (HAL_DMA_Start_IT(&hdma_tim2_ch1,
12731:Core/Src/main.c ****             (uint32_t)waveforms[wave_idx],
12732:Core/Src/main.c ****             (uint32_t)&TIM3->CCR3,
12733:Core/Src/main.c ****             NS) != HAL_OK) {
12734:Core/Src/main.c ****         Error_Handler();
12735:Core/Src/main.c ****     }
12736:Core/Src/main.c ****     __HAL_TIM_ENABLE_DMA(&htim2, TIM_DMA_CC1);
12737:Core/Src/main.c **** 
