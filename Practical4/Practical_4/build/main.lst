12740:Core/Src/main.c ****     lcd_putstring(wave_names[wave_idx]);
12741:Core/Src/main.c **** 
12742:Core/Src/main.c ****     HAL_GPIO_EXTI_IRQHandler(Button0_Pin); // Clear interrupt flags
12743:Core/Src/main.c **** }
